{
  "_comment": "Frozen ground truth. A human wrote this from the documents, before scoring any provider. A failing case is data about the system, not a bug in the key. Do not soften a case to make a provider pass.",
  "tolerance": {"number_rel": 1e-6, "ratio_abs": 0.01},
  "ratio_inputs": {
    "dscr": ["net_operating_income", "annual_debt_service"],
    "ltv": ["loan_amount", "appraised_value"]
  },
  "cases": {
    "case01_clean": {
      "purpose": "Happy path. Clean labels, all documents present.",
      "fields": {
        "borrower_name": "Acme Manufacturing LLC",
        "loan_amount": 4200000,
        "annual_revenue": 12500000,
        "net_operating_income": 1800000,
        "annual_debt_service": 1200000,
        "appraised_value": 6000000,
        "guarantor_net_worth": 2500000
      },
      "computed": {"dscr": 1.5, "ltv": 0.7},
      "expected_data_gaps": [],
      "expected_absent_computed": [],
      "adversarial": false
    },
    "case02_missing_debt_schedule": {
